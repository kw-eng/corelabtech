# CoreLabTech production environment template.
# Copy values into your real .env on VPS. Do not commit real secrets.

FLASK_APP=app.py
FLASK_ENV=production
APP_ENV=production

# Generate a long random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-secret

POSTGRES_DB=corelabtech
POSTGRES_USER=corelabtech_user
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql://corelabtech_user:replace-with-strong-database-password@db:5432/corelabtech

PERFORMANCE_TESTING=false
DISABLE_DEBUG_ROUTES=true

# Set to the exact public HTTPS origin used by the app.
CORS_ORIGINS=https://your-domain.example

SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_HTTPONLY=True

PLAYWRIGHT_BASE_URL=https://your-domain.example
GATLING_REPORTS_PATH=tests/performance/gatling/target/gatling

AI_MODE=wellness
AI_ENABLE_ANOMALY=True
AI_ENABLE_TRENDS=True
AI_ANALYSIS_TIMEOUT=120

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
ENABLE_METRICS=true
PROMETHEUS_ENABLED=false

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
