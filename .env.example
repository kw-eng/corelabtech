# =========================
# FLASK
# =========================
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-me

# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql://corelabtech_user:change-me@db:5432/corelabtech

# =========================
# SECURITY
# =========================
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_HTTPONLY=True
CORS_ORIGINS=
DISABLE_DEBUG_ROUTES=true

# =========================
# UPLOADS
# =========================
UPLOAD_FOLDER=data/uploads
MAX_CONTENT_LENGTH=52428800

# =========================
# PLAYWRIGHT
# =========================
PLAYWRIGHT_WORKERS=1
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5000

# Playwright E2E admin credentials
# Do not put real passwords in .env.example
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me

# =========================
# PERFORMANCE / GATLING
# =========================
PERFORMANCE_TESTING=false
INTERNAL_TOOLS_ENABLED=false
GATLING_REPORTS_PATH=tests/performance/gatling/target/gatling

# =========================
# AI SETTINGS
# =========================
AI_MODE=research
AI_ENABLE_ANOMALY=True
AI_ENABLE_TRENDS=True
AI_ANALYSIS_TIMEOUT=120

# Optional LLM narration. The deterministic wellness engine remains authoritative.
LLM_NARRATION_ENABLED=false
LLM_TREND_NARRATION_ENABLED=false
LLM_RESEARCH_NARRATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# =========================
# LOGGING
# =========================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# =========================
# FUTURE CLOUD DEPLOYMENT
# =========================
APP_ENV=development
APP_RUN_MIGRATIONS=true
DB_HOST_PORT=5432
# =========================
# GUNICORN
# =========================
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=300
# =========================
# MONITORING
# =========================
ENABLE_METRICS=true
PROMETHEUS_ENABLED=false
