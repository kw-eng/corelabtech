APP_ENV=production
FLASK_ENV=production
PERFORMANCE_TESTING=false
DISABLE_DEBUG_ROUTES=true

SECRET_KEY=replace-with-at-least-64-random-characters
DATABASE_URL=postgresql://corelabtech_user:replace-db-password@db:5432/corelabtech
POSTGRES_DB=corelabtech
POSTGRES_USER=corelabtech_user
POSTGRES_PASSWORD=replace-db-password

DOMAIN=wellness.example.com
LETSENCRYPT_EMAIL=operations@example.com
CORS_ORIGINS=https://wellness.example.com
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
REMEMBER_COOKIE_HTTPONLY=True

UPLOAD_FOLDER=data/uploads
MAX_CONTENT_LENGTH=52428800
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# Local encrypted backup volume. Copy backups off-server separately.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
